{
  "name": "jeu-de-piste-2026",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:mobile": "nuxt dev --https --public",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prod": "node scripts/prod.mjs",
    "postinstall": "nuxt prepare && prisma generate",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "db:up": "docker compose up -d",
    "db:push": "rm -rf prisma/migrations && prisma db push --force-reset",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@iconify-json/pixelarticons": "^1.2.10",
    "@iconify-json/solar": "^1.2.13",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/hints": "1.1.5",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/test-utils": "4.3.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "0.5.31",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "vue": "^3.5.43",
    "vue-qrcode-reader": "5.7.3",
    "vue-router": "^5.4.0",
    "zxing-wasm": "1.1.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "cloudflared": "0.7.3",
    "happy-dom": "^21.0.1",
    "prisma": "^7.10.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
